                    { id: 8, name: 'Medu Vada (2 pcs)', category: 'South Indian', price: 60, desc: 'Crispy golden fried lentil donuts with soft interior.', bestseller: false, jain: true },

                    // North Indian
                    { id: 9, name: 'Chole Bhature', category: 'North Indian', price: 110, desc: 'Fluffy fried bhaturas served with spicy punjabi chickpea masala and pickled onions.', bestseller: true, jain: false },
