<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIT Pune Canteen - Campus Bites</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            indigo: '#4f46e5',
                            darkIndigo: '#3730a3',
                            orange: '#f97316',
                            lightOrange: '#ffedd5',
                            dark: '#0f172a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-orange-500 selection:text-white" x-data="canteenApp()">

    <div class="fixed top-20 right-5 z-50 flex flex-col space-y-2 pointer-events-none">
        <template x-for="note in notifications" :key="note.id">
            <div x-transition:enter="transition ease-out duration-300" 
                 x-transition:enter-start="opacity-0 translate-y-2" 
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 translate-y-2"
                 class="bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl flex items-center space-x-3 pointer-events-auto border border-slate-700">
                <i :class="note.icon" class="text-orange-400"></i>
                <span class="text-sm font-medium" x-text="note.text"></span>
            </div>
        </template>
    </div>

    <nav class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <!-- Logo & Subtitle -->
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-indigo to-brand-orange flex items-center justify-center text-white shadow-lg shadow-indigo-500/20">
                        <i class="fa-solid fa-utensils text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-extrabold tracking-tight text-slate-900 block leading-none">SIT PUNE</span>
                        <span class="text-xs font-semibold text-brand-orange tracking-widest uppercase mt-1 block">Campus Canteen & Cafe</span>
                    </div>
                </div>

                <!-- Desktop Links -->
                <div class="hidden md:flex items-center space-x-8 font-medium text-sm text-slate-600">
                    <a href="#home" class="hover:text-brand-indigo transition">Home</a>
                    <a href="#specials" class="hover:text-brand-indigo transition">Daily Specials</a>
                    <a href="#menu" class="hover:text-brand-indigo transition">Full Menu</a>
                    <a href="#reviews" class="hover:text-brand-indigo transition">Reviews</a>
                    <a href="#status" class="hover:text-brand-indigo transition">Live Status</a>
                </div>

                <!-- Right Actions: Status Badge & Cart Button -->
                <div class="flex items-center space-x-4">
                    <!-- Live Status Pill -->
                    <div class="hidden sm:flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200">
                        <span class="relative flex h-2.5 w-2.5">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                        </span>
                        <span class="text-xs font-semibold text-emerald-700">Open • Normal Rush</span>
                    </div>

                    <!-- Cart Trigger Button -->
                    <button @click="cartOpen = true" class="relative bg-slate-900 hover:bg-brand-indigo text-white px-4 py-2.5 rounded-xl font-medium text-sm flex items-center space-x-2 transition shadow-md">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span>Order</span>
                        <span class="bg-brand-orange text-white text-xs px-2 py-0.5 rounded-full font-bold" x-text="totalItemsCount">0</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <header id="home" class="relative overflow-hidden bg-gradient-to-br from-indigo-900 via-slate-900 to-slate-950 text-white py-24 lg:py-32">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 bg-orange-500/10 border border-orange-500/30 text-orange-400 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider">
                        <i class="fa-solid fa-fire"></i>
                        <span>Lavale Hilltop Fuel Station</span>
                    </div>
                    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
                        Fuel Your Coding & <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-200">Late Night Grinds</span>
                    </h1>
                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 font-light">
                        Skip the queues at SIT Pune Canteen! Pre-order piping hot snacks, soothing chai, South Indian delicacies, and quick meals right from your device.
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start space-y-3 sm:space-y-0 sm:space-x-4 pt-4">
                        <a href="#menu" class="w-full sm:w-auto bg-brand-orange hover:bg-orange-600 text-white font-semibold px-8 py-4 rounded-xl shadow-lg shadow-orange-500/30 transition text-center flex items-center justify-center space-x-2">
                            <span>Explore Menu</span>
                            <i class="fa-solid fa-arrow-down"></i>
                        </a>
                        <a href="#status" class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/10 font-semibold px-8 py-4 rounded-xl transition text-center backdrop-blur-sm">
                            Check Live Canteen Rush
                        </a>
                    </div>
                    <!-- Quick Metrics -->
                    <div class="grid grid-cols-3 gap-4 pt-8 border-t border-slate-800 text-center lg:text-left">
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-orange-400">4.7★</p>
                            <p class="text-xs text-slate-400 mt-1">Student Rating</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-indigo-400">10 mins</p>
                            <p class="text-xs text-slate-400 mt-1">Avg Prep Time</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-400">100%</p>
                            <p class="text-xs text-slate-400 mt-1">Hygiene Assured</p>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        <div class="absolute -inset-2 bg-gradient-to-r from-orange-500 to-indigo-600 rounded-3xl blur-xl opacity-30 animate-pulse"></div>
                        <div class="relative bg-slate-900 border border-slate-800 p-6 rounded-3xl shadow-2xl space-y-6">
                            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                                <div class="flex items-center space-x-3">
                                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                                </div>
                                <span class="text-xs font-mono text-slate-400">canteen_live_feed.exe</span>
                            </div>
                            <div class="space-y-4">
                                <div class="bg-slate-800/60 p-4 rounded-xl flex items-center justify-between border border-slate-700/50">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center font-bold">☕</div>
                                        <div>
                                            <h4 class="text-sm font-bold text-white">Special Adrak Chai</h4>
                                            <p class="text-xs text-slate-400">Fresh brewed with cardamom</p>
                                        </div>
                                    </div>
                                    <span class="text-sm font-extrabold text-orange-400">₹20</span>
                                </div>
                                <div class="bg-slate-800/60 p-4 rounded-xl flex items-center justify-between border border-slate-700/50">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold">🧀</div>
                                        <div>
                                            <h4 class="text-sm font-bold text-white">Peri Peri Cheese Maggi</h4>
                                            <p class="text-xs text-slate-400">Student favorite choice</p>
                                        </div>
                                    </div>
                                    <span class="text-sm font-extrabold text-indigo-400">₹60</span>
                                </div>
                                <div class="bg-slate-800/60 p-4 rounded-xl flex items-center justify-between border border-slate-700/50">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">🍛</div>
                                        <div>
                                            <h4 class="text-sm font-bold text-white">Punjabi Thali Meal</h4>
                                            <p class="text-xs text-slate-400">Dal Makhani, Paneer, Roti, Rice</p>
                                        </div>
                                    </div>
                                    <span class="text-sm font-extrabold text-emerald-400">₹120</span>
                                </div>
                            </div>
                            <div class="pt-2 text-center">
                                <span class="text-xs text-slate-400">✨ Order now & skip the physical counter wait!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section id="specials" class="py-16 bg-white border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-brand-orange">Today's Recommendation</span>
                    <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Chef & Student Specials</h2>
                </div>
                <p class="text-slate-500 text-sm max-w-md mt-2 md:mt-0">Handpicked items prepared fresh today at the SIT Canteen kitchen. Grab them before they run out!</p>
            </div>

            <!-- Specials Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Special 1 -->
                <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl p-6 border border-orange-200/60 shadow-sm relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute top-4 right-4 bg-brand-orange text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                        Bestseller 🔥
                    </div>
                    <div>
                        <div class="w-14 h-14 bg-orange-500 text-white rounded-2xl flex items-center justify-center text-2xl shadow-md shadow-orange-500/30 mb-4">
                            🌯
                        </div>
                        <span class="text-xs font-semibold text-orange-600 bg-orange-100 px-2.5 py-1 rounded-md">Fast Food</span>
                        <h3 class="text-xl font-bold text-slate-900 mt-2">Schezwan Cheese Roll</h3>
                        <p class="text-slate-600 text-sm mt-1">Crispy paratha wrap stuffed with spicy schezwan veggies & liquid cheese.</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-orange-200/60 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-slate-500 block">Price</span>
                            <span class="text-lg font-extrabold text-slate-900">₹80</span>
                        </div>
                        <button @click="addToCart({id: 'spl-1', name: 'Schezwan Cheese Roll', price: 80, category: 'Fast Food', veg: true})" class="bg-brand-orange hover:bg-orange-600 text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-md flex items-center space-x-1.5">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>

                <!-- Special 2 -->
                <div class="bg-gradient-to-br from-indigo-50 to-blue-50 rounded-2xl p-6 border border-indigo-200/60 shadow-sm relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute top-4 right-4 bg-brand-indigo text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                        Chef Choice 👨‍🍳
                    </div>
                    <div>
                        <div class="w-14 h-14 bg-brand-indigo text-white rounded-2xl flex items-center justify-center text-2xl shadow-md shadow-indigo-500/30 mb-4">
                            🥘
                        </div>
                        <span class="text-xs font-semibold text-indigo-600 bg-indigo-100 px-2.5 py-1 rounded-md">South Indian</span>
                        <h3 class="text-xl font-bold text-slate-900 mt-2">Mysore Masala Dosa</h3>
                        <p class="text-slate-600 text-sm mt-1">Crispy golden crepe smeared with red garlic chutney and potato masala.</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-indigo-200/60 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-slate-500 block">Price</span>
                            <span class="text-lg font-extrabold text-slate-900">₹90</span>
                        </div>
                        <button @click="addToCart({id: 'spl-2', name: 'Mysore Masala Dosa', price: 90, category: 'South Indian', veg: true})" class="bg-brand-indigo hover:bg-brand-darkIndigo text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-md flex items-center space-x-1.5">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>

                <!-- Special 3 -->
                <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl p-6 border border-emerald-200/60 shadow-sm relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute top-4 right-4 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                        Jain Available 🌱
                    </div>
                    <div>
                        <div class="w-14 h-14 bg-emerald-600 text-white rounded-2xl flex items-center justify-center text-2xl shadow-md shadow-emerald-500/30 mb-4">
                            🧋
                        </div>
                        <span class="text-xs font-semibold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md">Beverages</span>
                        <h3 class="text-xl font-bold text-slate-900 mt-2">Cold Coffee with Ice Cream</h3>
                        <p class="text-slate-600 text-sm mt-1">Thick blended iced coffee topped with a rich scoop of vanilla ice cream.</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-emerald-200/60 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-slate-500 block">Price</span>
                            <span class="text-lg font-extrabold text-slate-900">₹70</span>
                        </div>
                        <button @click="addToCart({id: 'spl-3', name: 'Cold Coffee with Ice Cream', price: 70, category: 'Beverages', veg: true})" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-md flex items-center space-x-1.5">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="menu" class="py-20 bg-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-xs font-bold uppercase tracking-widest text-brand-indigo">Digital Menu Card</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-1">What's Cooking Today?</h2>
                <p class="text-slate-600 text-sm sm:text-base mt-2">Filter by categories or dietary preferences. Tap 'Add' to build your canteen order.</p>
            </div>

            <!-- Controls: Category Pills & Search -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10">
                <!-- Categories -->
                <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 w-full md:w-auto">
                    <template x-for="cat in categories" :key="cat">
                        <button @click="selectedCategory = cat" 
                                :class="selectedCategory === cat ? 'bg-brand-indigo text-white shadow-md shadow-indigo-500/20' : 'bg-white text-slate-600 hover:bg-slate-200 border border-slate-200'"
                                class="px-4 py-2 rounded-xl text-sm font-semibold transition"
                                x-text="cat">
                        </button>
                    </template>
                </div>

                <!-- Search & Filter Options -->
                <div class="flex items-center space-x-3 w-full md:w-auto justify-end">
                    <div class="relative w-full md:w-64">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-search"></i>
                        </span>
                        <input type="text" x-model="searchQuery" placeholder="Search dish name..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-indigo">
                    </div>
                    <button @click="jainOnly = !jainOnly" :class="jainOnly ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'" class="px-4 py-2.5 border rounded-xl text-sm font-semibold transition flex items-center space-x-1.5 shrink-0">
                        <i class="fa-solid fa-seedling"></i>
                        <span class="hidden sm:inline">Jain Only</span>
                    </button>
                </div>
            </div>

            <!-- Menu Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <template x-for="item in filteredMenuItems" :key="item.id">
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between group">
                        <div>
                            <div class="flex items-start justify-between">
                                <div class="flex items-center space-x-2">
                                    <span class="w-3 h-3 rounded-full border border-emerald-600 flex items-center justify-center p-0.5">
                                        <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full block"></span>
                                    </span>
                                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider" x-text="item.category"></span>
                                </div>
                                <div class="flex items-center space-x-1.5">
                                    <span x-show="item.bestseller" class="bg-orange-100 text-orange-700 text-xs font-bold px-2 py-0.5 rounded-md">Bestseller</span>
                                    <span x-show="item.jain" class="bg-emerald-100 text-emerald-700 text-xs font-bold px-2 py-0.5 rounded-md">Jain Available</span>
                                </div>
                            </div>
                            <h3 class="text-lg font-bold text-slate-900 mt-3 group-hover:text-brand-indigo transition" x-text="item.name"></h3>
                            <p class="text-slate-500 text-xs mt-1 leading-relaxed" x-text="item.desc"></p>
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <span class="text-xs text-slate-400 block">Price</span>
                                <span class="text-lg font-extrabold text-slate-900">₹<span x-text="item.price"></span></span>
                            </div>
                            <button @click="addToCart(item)" class="bg-slate-900 hover:bg-brand-indigo text-white px-4 py-2 rounded-xl text-sm font-semibold transition flex items-center space-x-1.5 shadow">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span>Add to Order</span>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Empty state -->
            <div x-show="filteredMenuItems.length === 0" class="text-center py-16 bg-white rounded-2xl border border-slate-200 mt-6">
                <i class="fa-solid fa-utensils text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-700">No matching dishes found</h3>
                <p class="text-slate-500 text-sm mt-1">Try adjusting your search terms or dietary filter.</p>
            </div>
        </div>
    </section>

    <section id="status" class="py-20 bg-white border-t border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-6 space-y-6">
                    <span class="text-xs font-bold uppercase tracking-widest text-brand-indigo">Real-time Telemetry</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Know the Canteen Rush Before You Walk Down</h2>
                    <p class="text-slate-600 text-base leading-relaxed">
                        Built for SIT students who want to avoid peak lecture-break rushes. Check real-time queue lengths, live seating availability, and average order preparation times.
                    </p>
                    
                    <div class="space-y-4 pt-2">
                        <div class="flex items-start space-x-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-brand-indigo flex items-center justify-center shrink-0 font-bold text-lg">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900">Peak Hours (Avoid if in a hurry)</h4>
                                <p class="text-xs text-slate-500 mt-0.5">11:15 AM - 11:45 AM (Recess) & 1:00 PM - 2:00 PM (Lunch Break)</p>
                            </div>
                        </div>
                        <div class="flex items-start space-x-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 font-bold text-lg">
                                <i class="fa-solid fa-bolt"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900">Fastest Pre-Order Window</h4>
                                <p class="text-xs text-slate-500 mt-0.5">Order 10 minutes prior via this web app to pick up directly from Counter #2.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Meter Card -->
                <div class="lg:col-span-6">
                    <div class="bg-gradient-to-br from-slate-900 to-indigo-950 text-white p-8 rounded-3xl shadow-2xl border border-slate-800 space-y-6">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                            <div class="flex items-center space-x-3">
                                <span class="relative flex h-3 w-3">
