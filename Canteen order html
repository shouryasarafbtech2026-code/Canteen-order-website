                    { id: 11, name: 'Punjabi Thali Meal', category: 'North Indian', price: 130, desc: 'Dal makhani, paneer gravy, 3 tawa rotis, jeera rice, salad, and sweet.', bestseller: true, jain: false },

                    // Beverages
                    { id: 12, name: 'Special Adrak Chai', category: 'Beverages', price: 20, desc: 'Strong ginger-infused milk tea brewed fresh.', bestseller: true, jain: true },
                    { id: 13, name: 'Filter Coffee', category: 'Beverages', price: 25, desc: 'Authentic South Indian degree coffee with frothy milk.', bestseller: false, jain: true },
                    { id: 14, name: 'Cold Coffee with Ice Cream', category: 'Beverages', price: 70, desc: 'Blended iced coffee topped with vanilla scoop.', bestseller: true, jain: true },
                    { id: 15, name: 'Fresh Lime Soda', category: 'Beverages', price: 35, desc: 'Refreshing sweet/salted lime soda with roasted cumin.', bestseller: false, jain: true },

                    // Fast Food
                    { id: 16, name: 'Peri Peri Cheese Maggi', category: 'Fast Food', price: 60, desc: 'Classic noodles tossed in spicy peri peri seasoning and loaded with grated cheese.', bestseller: true, jain: false },
                    { id: 17, name: 'Veg Grilled Sandwich', category: 'Fast Food', price: 50, desc: 'Loaded with cucumber, tomato, potato, mint chutney, and cheese slice.', bestseller: false, jain: true },
                    { id: 18, name: 'French Fries (Salted/Peri Peri)', category: 'Fast Food', price: 70, desc: 'Crispy deep-fried potato batons tossed in seasoning.', bestseller: true, jain: true },

                    // Desserts
                    { id: 19, name: 'Gulab Jamun (2 pcs)', category: 'Desserts', price: 40, desc: 'Soft khoya milk dumplings soaked in warm rose cardamom sugar syrup.', bestseller: true, jain: true },
                    { id: 20, name: 'Chocolate Brownie with Ice Cream', category: 'Desserts', price: 90, desc: 'Fudgy warm chocolate brownie served with a scoop of vanilla ice cream.', bestseller: true, jain: true }
                ],
                feedbackForm: {
                    name: '',
                    rating: '5',
                    comment: ''
                },
                get filteredMenuItems() {
                    return this.menuItems.filter(item => {
                        const matchesCategory = this.selectedCategory === 'All' || item.category === this.selectedCategory;
                        const matchesSearch = item.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || item.desc.toLowerCase().includes(this.searchQuery.toLowerCase());
                        const matchesJain = !this.jainOnly || item.jain;
                        return matchesCategory && matchesSearch && matchesJain;
                    });
                },
                addToCart(item) {
                    const existing = this.cart.find(i => i.id === item.id);
                    if (existing) {
                        existing.quantity++;
                    } else {
                        this.cart.push({ ...item, quantity: 1 });
                    }
                    this.showNotification(`Added ${item.name} to cart!`, 'fa-solid fa-cart-plus');
                },
                updateQuantity(id, change) {
                    const item = this.cart.find(i => i.id === id);
                    if (item) {
                        item.quantity += change;
                        if (item.quantity <= 0) {
                            this.cart = this.cart.filter(i => i.id !== id);
                        }
                    }
                },
                get totalItemsCount() {
                    return this.cart.reduce((sum, item) => sum + item.quantity, 0);
                },
                get cartTotal() {
                    return this.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                },
                checkout() {
                    if (!this.orderName.trim() || !this.orderPrn.trim()) {
                        this.showNotification('Please enter your Name and PRN / Roll Number!', 'fa-solid fa-triangle-exclamation');
                        return;
                    }
                    const orderId = 'SIT-' + Math.floor(1000 + Math.random() * 9000);
                    this.showNotification(`Order #${orderId} placed successfully! Please collect at Counter #2.`, 'fa-solid fa-circle-check');
                    this.cart = [];
                    this.orderName = '';
                    this.orderPrn = '';
                    this.cartOpen = false;
                },
                submitFeedback() {
                    this.showNotification('Thank you for your feedback! Posted to campus wall.', 'fa-solid fa-heart');
                    this.feedbackForm.name = '';
                    this.feedbackForm.comment = '';
                },
                showNotification(text, icon) {
                    const id = Date.now();
                    this.notifications.push({ id, text, icon });
                    setTimeout(() => {
                        this.notifications = this.notifications.filter(n => n.id !== id);
                    }, 4000);
                }
            }
        }
    </script>
